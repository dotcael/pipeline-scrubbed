    "expected": "reproduced",
    "why": "B's export contains A's marker; the marker came from A's record (not from B's request); the owner still gets it.",
    "marker": "GHOST-ALPHA-7f31",
    "marker_source": "other_principal_record",
    "requests": {
      "test": {
        "principal": "B",
        "method": "GET",
        "path": "/api/exports/9f2c",
        "status": 200,
        "body": "{\"rows\":[{\"title\":\"Q4 planning\",\"note\":\"GHOST-ALPHA-7f31\"}]}"
      },
      "control": {
        "principal": "A (owner)",
        "method": "GET",
        "path": "/api/exports/9f2c",
        "status": 200,
        "body": "{\"rows\":[{\"title\":\"Q4 planning\",\"note\":\"GHOST-ALPHA-7f31\"}]}"
      }
    }
  },
  {
